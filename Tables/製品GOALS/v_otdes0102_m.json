    "CreateViewSql": " SELECT otdes0102.tableid,\n    otdes0102.cancelflag,\n    otdes0102.intimestp,\n    otdes0102.uptimestp,\n    otdes0102.userid,\n    otdes0102.uppgid,\n    otdes0102.inuserid,\n    otdes0102.inpgid,\n    otdes0102.kdashi_no,\n    otdes0102.skairai_mno,\n    otdes0102.kban,\n    otdes0102.kata,\n    otdes0102.bkn_mno\n   FROM (otdes0102\n     LEFT JOIN otdes0100 ON ((otdes0100.kdashi_no = otdes0102.kdashi_no)))\n  WHERE (otdes0100.bu_kbn = ANY (ARRAY['M'::bpchar, 'N'::bpchar]));",
