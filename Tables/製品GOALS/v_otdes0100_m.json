    "CreateViewSql": " SELECT otdes0100.tableid,\n    otdes0100.cancelflag,\n    otdes0100.intimestp,\n    otdes0100.uptimestp,\n    otdes0100.userid,\n    otdes0100.uppgid,\n    otdes0100.inuserid,\n    otdes0100.inpgid,\n    otdes0100.kdashi_no,\n    otdes0100.skairai_no,\n    otdes0100.skairaibmon_cd,\n    otdes0100.bu_kbn,\n    otdes0100.skaszu_stat,\n    otdes0100.skaszusko_cd,\n    otdes0100.uchinftanbmon_cd,\n    otdes0100.bin_cd,\n    otdes0100.nnyubsho_cd,\n    otdes0100.nnyusk_pos1,\n    otdes0100.nnyusk_pos2,\n    otdes0100.nnyuskken_cd,\n    otdes0100.nnyusk_adr1,\n    otdes0100.nnyusk_adr2,\n    otdes0100.nnyuskatena,\n    otdes0100.nnyusk_tel_1,\n    otdes0100.nnyusktelmemo_1,\n    otdes0100.nnyusk_tel_2,\n    otdes0100.nnyusktelmemo_2,\n    otdes0100.dhyokata,\n    otdes0100.skaszu_tosu,\n    otdes0100.skaszushashu_cd,\n    otdes0100.ska_kdate,\n    otdes0100.toweight,\n    otdes0100.toarea,\n    otdes0100.egyohokan_flg,\n    otdes0100.bryuhokan_flg,\n    otdes0100.ysoiraisyohi_flg,\n    otdes0100.skoskaszusosinzm_flg,\n    otdes0100.skskszukesinzm_flg,\n    otdes0100.usogyshatawse_no,\n    otdes0100.skakgchi_su,\n    otdes0100.skaszureg_repdate,\n    otdes0100.skoska_date,\n    otdes0100.skahkokushri_date,\n    otdes0100.up_dtim,\n    otdes0100.yso_no,\n    otdes0100.tshoysoiraino_su,\n    otdes0100.szuksrirsnkbn,\n    otdes0100.yhsosystsho_kbn,\n    otdes0100.hsyaplanumu_kbn,\n    otdes0100.yhsosyssosinzm_flg\n   FROM otdes0100\n  WHERE (otdes0100.skairaibmon_cd IN ( SELECT otmrb4000.bmon_cd\n           FROM otmrb4000\n          WHERE ((otmrb4000.bu_kbn = 'M'::bpchar) OR (otmrb4000.bu_kbn = 'N'::bpchar))));",
