    "CreateViewSql": " SELECT otdes0101.tableid,\n    otdes0101.cancelflag,\n    otdes0101.intimestp,\n    otdes0101.uptimestp,\n    otdes0101.userid,\n    otdes0101.uppgid,\n    otdes0101.inuserid,\n    otdes0101.inpgid,\n    otdes0101.kdashi_no,\n    otdes0101.skairai_mno,\n    otdes0101.bkn_mno,\n    otdes0101.kata,\n    otdes0101.ac_kbn,\n    otdes0101.skaszu_su,\n    otdes0101.weight_one,\n    otdes0101.area_one,\n    otdes0101.tumiknodn_su,\n    otdes0101.weightkei,\n    otdes0101.areakei\n   FROM (otdes0101\n     LEFT JOIN otdes0100 ON ((otdes0100.kdashi_no = otdes0101.kdashi_no)))\n  WHERE (otdes0100.bu_kbn = ANY (ARRAY['M'::bpchar, 'N'::bpchar]));",
