    "SourceTableName": "ymia_v_seihindb_shukka",
    "SourceTableSchema": "",
    "CreateViewSql": "select `j`.`KISHU` AS `KISHU`,`j`.`KIBAN` AS `KIBAN`,`j`.`SHIYO_CODE` AS `SHIYO_CODE`,`j`.`KIBO_NOKI` AS `KIBO_NOKI`,`j`.`TORIHIKISAKI_CODE` AS `TORIHIKISAKI_CODE`,`j`.`NONYUSAKI` AS `NONYUSAKI`,`j`.`NONYUSAKI_TANTOSHA` AS `NONYUSAKI_TANTOSHA`,`j`.`HANBAI_KATASHIKI` AS `HANBAI_KATASHIKI`,`j`.`ENGINE_KATASHIKI` AS `ENGINE_KATASHIKI`,`j`.`ENGINE_NO` AS `ENGINE_NO`,`j`.`DRIVE_KATASHIKI` AS `DRIVE_KATASHIKI`,`j`.`DRIVE_NO` AS `DRIVE_NO`,`sy`.`SHUKKA_YOTEI_DATE` AS `SHUKKA_YOTEI_DATE`,`sy`.`SHUKKA_DATE` AS `SHUKKA_DATE`,`sy`.`SHUKKA_TIME` AS `SHUKKA_TIME`,`sy`.`TOCHAKU_DATE` AS `TOCHAKU_DATE`,`sy`.`TOCHAKU_TIME` AS `TOCHAKU_TIME`,`sy`.`RIKUKAI_KUBUN` AS `RIKUKAI_KUBUN`,`sy`.`TEHAI_KUBUN` AS `TEHAI_KUBUN`,`sy`.`SHASHU` AS `SHASHU`,`sy`.`UNSO_GYOSHA` AS `UNSO_GYOSHA`,`sy`.`DOSOHIN` AS `DOSOHIN`,`sy`.`RENRAKU_JIKO` AS `RENRAKU_JIKO`,`sy`.`SHANAI_RENRAKU_JIKO` AS `SHANAI_RENRAKU_JIKO`,`sh`.`KENMEI` AS `KENMEI`,`sh`.`SHODAN_JOKYO` AS `SHODAN_JOKYO`,`sh`.`ORDER_NO` AS `ORDER_NO` from ((`tjuchu` `j` join `t_shukka_yotei` `sy` on((`j`.`JUCHU_NBR` = `sy`.`JUCHU_NBR`))) join `tshodan` `sh` on((`j`.`KANRI_NBR` = `sh`.`KANRI_NBR`)))",
