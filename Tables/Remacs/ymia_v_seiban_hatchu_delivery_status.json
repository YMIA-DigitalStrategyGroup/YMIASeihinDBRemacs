    "SourceTableName": "ymia_v_seiban_hatchu_delivery_status",
    "SourceTableSchema": "",
    "CreateViewSql": "select `m`.`SEIBAN` AS `製番`,`h`.`TORIHIKISAKI_CODE` AS `取引先コード`,`h`.`TORIHIKISAKI_NAME` AS `取引先名`,`m`.`HATCHU_NBR` AS `発注No`,`m`.`DENPYO_NBR` AS `伝票No`,`h`.`HATCHU_DATE` AS `発注日`,`h`.`NOKI` AS `希望納期`,`uk`.`納品日` AS `納品日`,`b`.`KURADASHI_KOTEI` AS `倉出工程`,coalesce(`uk`.`UKEIRE_TANKA`,`m`.`TANKA`) AS `受入単価`,`m`.`HINBAN` AS `HINBAN`,`m`.`HINMEI` AS `品名`,`m`.`SURYO` AS `発注数量`,`m`.`KANRYO_FLAG` AS `完了フラグ`,`m`.`KARI_KANRYO_FLAG` AS `仮完了フラグ`,(case when (`m`.`KANRYO_FLAG` = 1) then '納品済' when (`m`.`KARI_KANRYO_FLAG` = 1) then '一部納品（仮完了）' else '未納品' end) AS `納品ステータス` from (((`thatchum` `m` join `thatchu` `h` on((`m`.`HATCHU_NBR` = `h`.`HATCHU_NBR`))) left join `tbuhink` `b` on((`m`.`BUHIN_KOSEI_ID` = `b`.`ID`))) left join (select `t1`.`DENPYO_NBR` AS `DENPYO_NBR`,`t1`.`UKEIRE_DATE` AS `納品日`,`t1`.`TANKA` AS `UKEIRE_TANKA` from `tukeire` `t1` where (`t1`.`UKEIRE_SEQ_NBR` = (select max(`t2`.`UKEIRE_SEQ_NBR`) from `tukeire` `t2` where (`t2`.`DENPYO_NBR` = `t1`.`DENPYO_NBR`)))) `uk` on((`m`.`DENPYO_NBR` = `uk`.`DENPYO_NBR`))) where ((`m`.`DELETE_FLG` = 0) or (`m`.`DELETE_FLG` is null))",
